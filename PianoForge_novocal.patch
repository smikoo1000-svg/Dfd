+# =========================================================================== 보컬 오채보 억제 / 소스 추천 (v4.3)
+# 보컬이 남은 소스(nodrums 등)에서는 보컬 선율이 피아노 음으로 채보된다. 보컬 스템에 같은 시각·같은 음이 있고
+# 반주(other) 스템에는 없는 음은 "보컬 유령음"으로 보고 벨로시티만 낮춘다(삭제하지 않음: 진짜 유니슨을 살리기 위함).
+
+
+def onset_tolerance_s(beat_s: float) -> float:
+    """박 길이의 1/8, 단 0.04~0.10초 안에서만 움직인다(느린 곡은 어택이 퍼지고 빠른 곡은 겹치기 쉬움)."""
+    return min(0.10, max(0.04, beat_s / 8.0))
+
+
+def suppress_vocal_ghosts(piano_notes, vocal_notes, other_notes, beat_s=0.5, alpha=0.3):
+    """(감쇠된 음 목록, 통계). (a) vocal_notes에 같은 onset(±tol)·같은 음(옥타브 ±12, ±24 허용)이 있고
+    (b) other_notes에는 그 음(같은 onset·같은 음높이)이 없으면 보컬 유령음 → 벨로시티 × alpha. 음 자체는 그대로 둔다."""
+    import bisect
+
+    tol = onset_tolerance_s(beat_s)
+
+    def index(notes):
+        by: dict[int, list[float]] = {}
+        for n in notes:
+            by.setdefault(n.pitch, []).append(n.onset_s)
+        for v in by.values():
+            v.sort()
+        return by
+
+    def has(by, pitch, t):
+        v = by.get(pitch)
+        if not v:
+            return False
+        i = bisect.bisect_left(v, t - tol)
+        return i < len(v) and v[i] <= t + tol
+
+    voc, oth = index(vocal_notes or ()), index(other_notes or ())
+    out: list[TNote] = []
+    flagged: list[int] = []
+    ghosts = octave = 0
+    for i, pn in enumerate(piano_notes):
+        in_vocal = any(has(voc, pn.pitch + d, pn.onset_s) for d in (0, 12, -12, 24, -24))
+        if in_vocal and not has(oth, pn.pitch, pn.onset_s):
+            ghosts += 1
+            flagged.append(i)
+            octave += 0 if has(voc, pn.pitch, pn.onset_s) else 1
+            out.append(TNote(pn.onset_s, pn.offset_s, pn.pitch, max(1, int(round(pn.velocity * alpha)))))
+        else:
+            out.append(TNote(pn.onset_s, pn.offset_s, pn.pitch, pn.velocity))
+    total = len(out)
+    return out, {"total": total, "vocal_ghosts": ghosts, "kept": total - ghosts, "octave_ghosts": octave, "ghost_index": flagged,
+                 "alpha": alpha, "onset_tol_s": round(tol, 4), "vocal_notes": len(vocal_notes or ()), "other_notes": len(other_notes or ())}
+
+
+def stem_notes_from_cqt(db, fps, top_k=1, floor_db=-10.0, frame_gate=None, min_len_s=0.06, bridge_s=0.04):
+    """88건반 상대 CQT(dB, 프레임별 최대 0)에서 '이 시각에 이 음이 울린다'는 증거용 음 목록을 만든다.
+    전사 모델이 아니라 봉우리 추적이다: 프레임마다 음높이 방향 극대점 중 상위 top_k개를 잇는다(numpy만 사용).
+    frame_gate: 프레임별 bool(소리가 있는 프레임만 허용) — 무음 프레임의 상대 dB 잡음을 막는다."""
+    import numpy as np
+
+    db = np.asarray(db)
+    nb, nt = db.shape
+    pad = np.pad(db, ((1, 1), (0, 0)), constant_values=-200.0)
+    peak = (db >= pad[:-2]) & (db > pad[2:]) & (db >= floor_db)
+    if top_k and top_k < nb:
+        thr = -np.sort(-np.where(peak, db, -200.0), axis=0)[top_k - 1]
+        peak &= db >= thr[None, :]
+    if frame_gate is not None:
+        peak &= np.asarray(frame_gate, dtype=bool)[None, :nt]
+    bridge, min_len = max(1, int(round(bridge_s * fps))), max(1, int(round(min_len_s * fps)))
+    notes = []
+    for k in range(nb):
+        row = np.concatenate(([False], peak[k], [False]))
+        edges = np.flatnonzero(row[1:] != row[:-1])
+        runs = [(int(a), int(b)) for a, b in zip(edges[0::2], edges[1::2])]
+        merged: list[list[int]] = []
+        for a, b in runs:
+            if merged and a - merged[-1][1] <= bridge:
+                merged[-1][1] = b
+            else:
+                merged.append([a, b])
+        for a, b in merged:
+            if b - a >= min_len:
+                notes.append(TNote(a / fps, b / fps, 21 + k, 64))
+    return sorted(notes, key=lambda n: (n.onset_s, n.pitch))
+
+
+def stem_rms_db(path) -> float:
+    """스템 파일의 RMS(dBFS). 블록 단위로 읽어 메모리를 아낀다."""
+    import soundfile as sf
+
+    tot, cnt = 0.0, 0
+    with sf.SoundFile(str(path)) as fh:
+        for blk in fh.blocks(blocksize=1 << 18, dtype="float32", always_2d=True):
+            tot += float((blk.astype("float64") ** 2).sum())
+            cnt += blk.size
+    return 10.0 * _math.log10(tot / cnt + 1e-20) if cnt else -120.0
+
+
+def recommend_piano_source(stem_energies: dict) -> dict:
+    """스템 RMS(dBFS) → 추천 piano_source. 비율은 mix 대비 '전력' 비율(보컬/mix > 0.25 이면 보컬이 큼).
+    stem_energies: {"vocals": dB, "drums": dB, "bass": dB, "other": dB, ["piano": dB,] ["mix": dB]}"""
+    stems = {k: v for k, v in stem_energies.items() if k != "mix" and v is not None}
+    if len(stems) < 2:
+        return {"source": "mix", "reason": "스템 정보가 부족해 분리 없이 원곡 전체를 권장합니다", "ratios": {}}
+    mix_db = stem_energies.get("mix")
+    if mix_db is None:
+        mix_db = 10.0 * _math.log10(sum(10 ** (v / 10.0) for v in stems.values()))
+    ratios = {k: 10 ** ((v - mix_db) / 10.0) for k, v in stems.items()}
+    r = lambda k: ratios.get(k, 0.0)
+    if "piano" in ratios and r("piano") > 0.40 and r("piano") >= r("vocals"):
+        src, why = "piano", f"피아노 스템이 지배적입니다(mix 대비 {r('piano'):.0%}) → 6스템 피아노 스템"
+    elif r("vocals") > 0.25:
+        src, why = "nodrums_vocals", f"보컬 비율이 큽니다(mix 대비 {r('vocals'):.1%}, 기준 25% 초과) → 원곡 − 드럼 − 보컬"
+    elif r("vocals") < 0.05 and r("bass") < 0.05 and r("drums") < 0.05 and r("other") > 0.5:
+        src, why = "other", f"반주 스템이 거의 전부입니다(other {r('other'):.0%}) → 반주 스템만"
+    elif r("drums") > 0.5:
+        src, why = "nodrums", f"드럼이 강합니다(drums {r('drums'):.0%}) → 원곡 − 드럼"
+    else:
+        src, why = "nodrums", f"보컬 비율 {r('vocals'):.0%}(≤ 25%) → 기본값 원곡 − 드럼"
+    return {"source": src, "reason": why, "ratios": {k: round(v, 3) for k, v in ratios.items()}}
+
+
+def mix_vocal_residual(piano_path, vocal_path, alpha, read_audio, write_wav):
+    """piano_source.wav(= 원곡 − 드럼)에서 보컬 스템 × alpha 를 더 뺀다(같은 파일에 원자적으로 덮어씀). 반환: (오디오, sr)."""
+    piano, sr = read_audio(piano_path)
+    voc, vsr = read_audio(vocal_path)
+    if vsr != sr or voc.shape[1] != piano.shape[1]:
+        n = min(voc.shape[1], piano.shape[1])
+        voc, piano = voc[:, :n], piano[:, :n]
+    ch = min(voc.shape[0], piano.shape[0])
+    out = piano.copy()
+    out[:ch] = piano[:ch] - alpha * voc[:ch]
+    write_wav(piano_path, out, sr, subtype="FLOAT")
+    return out, sr
+
